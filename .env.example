# Copy to .env (gitignored) and fill in. Never commit real keys.

# Model calls go to Gemini's OpenAI-compatible endpoint.
GEMINI_API_KEY=your-gemini-key-here

# Traces are exported to platform.openai.com under your own key (FR-13).
# Set SHOP_DESK_TRACING=off to run without tracing.
OPENAI_API_KEY=your-openai-key-here
SHOP_DESK_TRACING=on

# FR-1: the cheap process default and the reasoning override.
FAST_MODEL=gemini-2.5-flash
REASONING_MODEL=gemini-2.5-pro
